# ============================================
# InterviewIQ AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.

# ---- Database ----
# For development (SQLite): sqlite:///./interviewiq.db
# For production (PostgreSQL): postgresql://user:password@host:5432/interviewiq
DATABASE_URL=sqlite:///./interviewiq.db

# ---- JWT Authentication ----
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- LLM API (OpenAI-compatible) ----
# Set your OpenAI API key for question generation and conversational feedback
OPENAI_API_KEY=your-openai-api-key
# Optional: Use a custom base URL for local LLM (e.g., Ollama, vLLM)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=gpt-4o-mini

# ---- File Upload ----
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000

